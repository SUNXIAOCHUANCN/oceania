        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u5728\u4E89\u8BBA\u4EC0\u4E48\u5462\uFF1F"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u8DF3\u4E0B\u77F3\u5934\uFF0C\u773C\u775B\u4EAE\u6676\u6676\u5730\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u62C9\u62C9"
  - text: "\u57FA\u8BFA\u59D0\u59D0\uFF01\u6211\u4EEC\u5728\u6BD4\u8D5B\u5531\u201C\u5C9B\u8C23\u201D\uFF0C\u4F46\u4ED6\u4EEC\u603B\u5531\u9519\uFF01"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u62C9\u62C9"
  - text: "\u90A3\u8BA9\u6211\u4E5F\u542C\u542C\u770B\uFF0C\u662F\u4E0D\u662F\u8FD9\u6837\u2014\u2014\u201C\u5F2F\u5F2F\u7684\u6708\u513F\uFF0C\u8EBA\u5728\u6D77\u4E2D\u592E\u2026\u2026\u201D"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u9F50\u58F0\u63A5\u4E0A\uFF0C\u624B\u62C9\u624B\u8F7B\u8F7B\u6447\u6643\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u5B69\u5B50\u4EEC"
  - text: "\u4E00\u5934\u6795\u7740\u73CA\u745A\u5E8A\uFF0C\u4E00\u5934\u7FD8\u7740\u770B\u8FDC\u65B9\uFF01"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u5B69\u5B50\u4EEC"
  - text: "\uFF08\u5174\u594B\u5730\u6BD4\u5212\u7740\u5F27\u7EBF\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u62C9\u62C9"
  - text: "\u957F\u957F\u7684\u5C3E\u5DF4\u5C16\uFF0C\u6307\u5411\u661F\u8FB0\u843D\u4E0B\u7684\u5730\u65B9\u2026\u2026"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u62C9\u62C9"
  - text: "\uFF08\u82E5\u6709\u6240\u601D\u5730\u91CD\u590D\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u5C3E\u5DF4\u5C16\u2026\u2026\u5411\u5185\u5F2F\u2026\u2026"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u51D1\u8FD1\u4E9B\uFF0C\u5E26\u7740\u5206\u4EAB\u79D8\u5BC6\u7684\u53E3\u6C14\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u62C9\u62C9"
  - text: "\u963F\u7237\u8BF4\uFF0C\u4ECE\u5F88\u9AD8\u7684\u5C71\u6216\u5F88\u8FDC\u7684\u8239\u4E0A\u770B\uFF0C\u6211\u4EEC\u7684\u5C9B\u5C31\u50CF\u4E00\u53EA\u5C3E\u5DF4\u5F2F\u5F2F\u7684\u957F\u5C3E\u9E1F\uFF01"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u62C9\u62C9"
  - text: "\uFF08\u671B\u5411\u8FDC\u65B9\u6D77\u89D2\u6C99\u6EE9\u4E0A\u7684\u7267\u573A\u7BF1\u7B06\uFF0C\u8F7B\u58F0\u81EA\u8BED\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u539F\u6765\u6211\u4EEC\u811A\u4E0B\u7684\u571F\u5730\uFF0C\u4ECE\u8FDC\u5904\u770B\u662F\u8FD9\u6837\u7684\u5F62\u72B6\u2026\u2026\u5982\u679C\u8FDE\u81EA\u5DF1\u7684\u5C9B\u90FD\u770B\u4E0D\u6E05\uFF0C\u53C8\u600E\u4E48\u80FD\u770B\u6E05\u8FDC\u65B9\u7684\u8DEF\uFF1F"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u8F6C\u5411\u5B69\u5B50\u4EEC\uFF0C\u5FAE\u7B11\u7740\u8BF4\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u8C22\u8C22\u4F60\u4EEC\uFF0C\u8FD9\u9996\u6B4C\u63D0\u9192\u4E86\u6211\u2014\u2014\u8981\u770B\u6E05\u5BB6\u4E61\uFF0C\u5F97\u5148\u77E5\u9053\u81EA\u5DF1\u62E5\u6709\u4EC0\u4E48\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u76EE\u5149\u626B\u8FC7\u8FDC\u65B9\u5404\u5904\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u6211\u73B0\u5728\u5C31\u53BB\u6D77\u89D2\u6C99\u6EE9\u7684\u7267\u573A\u770B\u770B\u6211\u4EEC\u7684\u7272\u755C\uFF0C\u518D\u53BB\u8425\u5730\u65C1\u5C71\u4E0A\u7684\u683D\u57F9\u6797\u6E05\u70B9\u6728\u6750\uFF0C\u6700\u540E\u5230\u5357\u8FB9\u6C99\u6EE9\u7684\u9999\u8549\u6811\u519C\u7530\u68C0\u67E5\u6536\u6210\u3002\u53EA\u6709\u6E05\u70B9\u597D\u5BB6\u5E95\uFF0C\u624D\u77E5\u9053\u6211\u4EEC\u80FD\u8D70\u591A\u8FDC\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u73B0\u5728\u6211\u5148\u53BB\u770B\u770B\u5E93\u62C9\u5976\u5976\u5427\uFF0C\u5C31\u5728\u8425\u5730\u53E6\u4E00\u8FB9"
