  m_Script: {fileID: 11500000, guid: 8d6101cc697a2ac419c085dd72cad93f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueStrings:
  - text: "\uFF08\u5411\u524D\u8FC8\u51FA\u4E00\u6B65\uFF0C\u76EE\u5149\u626B\u8FC7\u57FA\u8BFA\u7684\u9762\u5BB9\u3001\u8863\u7740\uFF0C\u6700\u7EC8\u843D\u5728\u4ED6\u8170\u95F4\u90A3\u679A\u5C5E\u4E8E\u957F\u5C3E\u9E1F\u65CF\u957F\u7684\u7389\u9970\u4E0A\u3002\u5979\u7684\u5634\u89D2\u626C\u8D77\u4E00\u4E2A\u4E86\u7136\u800C\u70ED\u70C8\u7684\u7B11\u5BB9\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u963F\u65AF\u7279\u62C9"
  - text: "\u98CE\u4E0E\u661F\u6307\u5F15\u4E86\u4F60\uFF0C\u8FDC\u822A\u7684\u65CF\u957F\u3002\u6B22\u8FCE\u8E0F\u4E0A\u5341\u5B57\u661F\u7684\u571F\u5730\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u963F\u65AF\u7279\u62C9"
  - text: "\uFF08\u5FAE\u5FAE\u6B20\u8EAB\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u611F\u8C22\u60A8\u7684\u8FCE\u63A5\u3002\u6211\u662F\u57FA\u8BFA\uFF0C\u6765\u81EA\u957F\u5C3E\u9E1F\u5C9B\u3002\u60A8\u7684\u76EE\u5149\u6BD4\u6D77\u9E70\u66F4\u9510\u5229\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u53D1\u51FA\u4E00\u9635\u723D\u6717\u7684\u7B11\u58F0\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u963F\u65AF\u7279\u62C9"
  - text: "\u4E0D\uFF0C\u4E0D\u662F\u6211\u7684\u76EE\u5149\u9510\u5229\uFF0C\u662F\u4F60\u5468\u8EAB\u8FD8\u8426\u7ED5\u7740\u6D77\u6D0B\u7684\u6C14\u606F\uFF0C\u773C\u91CC\u8FD8\u6620\u7740\u672A\u6563\u5C3D\u7684\u661F\u56FE\u3002\u53EA\u6709\u771F\u6B63\u7A7F\u8D8A\u4E86\u65E0\u8FF9\u4E4B\u6D77\u7684\u4EBA\uFF0C\u624D\u4F1A\u6709\u8FD9\u6837\u7684\u795E\u91C7\u3002\u6211\u4EEC\u5341\u5B57\u661F\u5C9B\u6C11\uFF0C\u5BF9\u8FD9\u6837\u7684\u795E\u91C7\u518D\u719F\u6089\u4E0D\u8FC7\u4E86\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u963F\u65AF\u7279\u62C9"
  - text: "\uFF08\u70B9\u5934\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u6211\u6B63\u662F\u4E3A\u8FFD\u5BFB\u5148\u8F88\u7684\u661F\u8FB0\u4E0E\u6CE2\u6D9B\u800C\u6765\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u8D5E\u8D4F\u5730\u770B\u7740\u4ED6\uFF0C\u4FA7\u8EAB\u8BA9\u51FA\u901A\u5411\u6751\u843D\u7684\u8DEF\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u963F\u65AF\u7279\u62C9"
  - text: "\u90A3\u4E48\uFF0C\u8FFD\u5BFB\u8005\uFF0C\u5341\u5B57\u661F\u5C9B\u5C31\u5728\u4F60\u9762\u524D\u4E86\u3002\u4F46\u6211\u60F3\uFF0C\u6B64\u523B\u4F60\u9700\u8981\u7684\u4E0D\u662F\u6211\u5197\u957F\u7684\u4ECB\u7ECD------\u54EA\u91CC\u7684\u6E2F\u53E3\u6700\u7F8E\uFF0C\u54EA\u5EA7\u5C71\u4E18\u7684\u89C6\u91CE\u6700\u5F00\u9614\uFF0C\u54EA\u79CD\u6D46\u679C\u6700\u751C\u3002\u90A3\u4E9B\u6587\u5B57\uFF0C\u5E94\u8BE5\u7531\u4F60\u7684\u53CC\u811A\u6765\u4E66\u5199\uFF0C\u7531\u4F60\u7684\u773C\u775B\u6765\u9605\u8BFB\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u963F\u65AF\u7279\u62C9"
  - text: "\uFF08\u9732\u51FA\u771F\u8BDA\u7684\u7B11\u5BB9\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u60A8\u8BF4\u5F97\u5BF9\u3002\u6BD4\u8D77\u5411\u5BFC\uFF0C\u6211\u66F4\u9700\u8981\u4E00\u53CC\u80FD\u81EA\u7531\u89C2\u5BDF\u7684\u773C\u775B\u548C\u4E00\u5BF9\u80FD\u503E\u542C\u7684\u8033\u6735\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u90A3\u5C31\u5C3D\u7BA1\u53BB\u770B\uFF0C\u53BB\u542C\u5427\u3002\u6211\u4EEC\u7684\u5C9B\u5C7F\u4E0D\u5927\uFF0C\u4F46\u6BCF\u4E00\u4E2A\u89D2\u843D\u90FD\u53EF\u80FD\u85CF\u7740\u6545\u4E8B\u3002\u548C\u7801\u5934\u7684\u6C34\u624B\u804A\u804A\u98CE\u6D6A\uFF0C\u548C\u5C71\u4E0A\u7684\u7267\u4EBA\u804A\u804A\u661F\u8FB0\uFF0C\u751A\u81F3\u53EF\u4EE5\u53BB\u542C\u542C\u6811\u4E0B\u8001\u4EBA\u4EEC\u7684\u95F2\u804A\u3002\u5341\u5B57\u661F\u7684\u6545\u4E8B\uFF0C\u5C31\u5728\u4ED6\u4EEC\u7684\u751F\u6D3B\u3001\u4ED6\u4EEC\u7684\u52B3\u4F5C\u3001\u4ED6\u4EEC\u671B\u5411\u5927\u6D77\u4E0E\u5929\u7A7A\u7684\u76EE\u5149\u91CC\u3002\u53EA\u8981\u4F60\u5FC3\u6000\u5C0A\u91CD\uFF0C\u8FD9\u91CC\u7684\u4EBA\u6C11\u4F1A\u5411\u4F60\u5C55\u9732\u771F\u5B9E\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
