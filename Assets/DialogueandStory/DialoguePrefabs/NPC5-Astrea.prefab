    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u975E\u5E38\u611F\u8C22\uFF0C\u963F\u65AF\u7279\u62C9\u914B\u957F\u3002\u8FD9\u4EFD\u7406\u89E3\u548C\u8BB8\u53EF\uFF0C\u5BF9\u6211\u800C\u8A00\uFF0C\u6BD4\u4EFB\u4F55\u4E30\u76DB\u7684\u5BB4\u5E2D\u90FD\u66F4\u73CD\u8D35\u3002"
