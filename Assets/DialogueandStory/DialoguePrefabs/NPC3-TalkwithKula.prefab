  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueStrings:
  - text: "\uFF08\u5728\u5976\u5976\u8EAB\u8FB9\u7684\u8349\u57AB\u4E0A\u5750\u4E0B\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u5976\u5976\uFF0C\u6211\u60F3\u518D\u542C\u542C\u7956\u5148\u662F\u5982\u4F55\u6765\u5230\u8FD9\u91CC\u7684\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u653E\u4E0B\u624B\u4E2D\u7684\u7F16\u7EC7\uFF0C\u76EE\u5149\u60A0\u8FDC\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u5E93\u62C9\u5976\u5976"
  - text: "\u5728\u5F88\u4E45\u4EE5\u524D\uFF0C\u4ED6\u4EEC\u8FFD\u968F\u84DD\u6708\u7684\u5149\uFF0C\u4E58\u7740\u72EC\u6728\u821F\u5411\u897F\u822A\u884C\u3002\u7A7F\u8D8A\u98CE\u66B4\u548C\u6D53\u96FE\uFF0C\u6700\u540E\u770B\u5230\u4E86\u957F\u5C3E\u9E1F\uFF0C\u627E\u5230\u4E86\u8FD9\u5EA7\u5C9B\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u5E93\u62C9\u5976\u5976"
  - text: "\uFF08\u6C89\u6D78\u5176\u4E2D\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u6240\u4EE5\u4ED6\u4EEC\u771F\u7684\u8DE8\u8FC7\u4E86\u5927\u6D77\u2026\u2026"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u610F\u5473\u6DF1\u957F\u5730\u770B\u7740\u57FA\u8BFA\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u5E93\u62C9\u5976\u5976"
  - text: "\u5B69\u5B50\uFF0C\u5927\u6D77\u662F\u9053\u8DEF\uFF0C\u4E0D\u662F\u56F4\u5899\u3002\u4F46\u8DEF\u8981\u8D70\u5F97\u8FDC\uFF0C\u5F97\u5148\u6709\u80FD\u8F7D\u4F60\u7684\u8239\u2014\u2014\u4E5F\u79BB\u4E0D\u5F00\u80FD\u5212\u8239\u7684\u4EBA\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u5E93\u62C9\u5976\u5976"
  - text: "\uFF08\u90D1\u91CD\u5730\u70B9\u5934\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u60A8\u8BF4\u5F97\u5BF9\u3002\u5982\u679C\u8239\u4E0D\u7ED3\u5B9E\uFF0C\u518D\u5F3A\u7684\u98CE\u4E5F\u65E0\u6CD5\u5E26\u4F60\u53BB\u8FDC\u65B9\uFF1B\u5982\u679C\u6CA1\u6709\u4EBA\u624B\uFF0C\u518D\u597D\u7684\u8239\u4E5F\u65E0\u6CD5\u72EC\u81EA\u822A\u884C\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\uFF08\u8D77\u8EAB\uFF0C\u76EE\u5149\u575A\u5B9A\u5730\u671B\u5411\u8425\u5730\u5E7F\u573A\uFF09"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u6211\u73B0\u5728\u5C31\u53BB\u8425\u5730\u91CC\u627E\u5927\u5BB6\uFF0C\u770B\u770B\u8C01\u64C5\u957F\u822A\u6D77\u8BE5\u505A\u6C34\u624B\uFF0C\u8C01\u61C2\u5F97\u79CD\u690D\u8BE5\u7BA1\u519C\u7530\uFF0C\u8C01\u53C8\u80FD\u9A6F\u5316\u52A8\u7269\u3002\u6211\u5F97\u628A\u6BCF\u4E2A\u4EBA\u90FD\u5B89\u6392\u5230\u5408\u9002\u7684\u4F4D\u7F6E\u4E0A\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u73B0\u5728\u4F60\u53EF\u4EE5\u524D\u5F80\u8425\u5730\u6700\u5927\u7684\u5E10\u7BF7\u5185\u7BA1\u7406\u4EBA\u53E3"
    isEnd: 1
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 0
    option2IndexJump: 0
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: "\u57FA\u8BFA"
  - text: "\u4EBA\u53E3\u53EF\u4EE5\u62DB\u52DF\u548C\u89E3\u96C7\uFF0C\u4EBA\u53E3\u4F1A\u6D88\u8017\u8D44\u6E90"
    isEnd: 1
    isQuestion: 0
