  - text: "\u6211\u4EEC\u7684\u5BB6\u56ED\u5982\u4F55\u800C\u6765"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u5929\u661F\u5760\u9668\u800C\u6765\uFF0C\u5148\u7956\u8FFD\u968F\u5929\u661F\u5230\u8FBE\u8FD9\u91CC\uFF0C\u8FD9\u662F\u5341\u5B57\u661F\u5C9B\u7684\u5F00\u59CB\u3002"
    answerOption2: "\u6211\u4EEC\u4ECE\u7389\u4E4B\u57CE\u51FA\u53D1\uFF0C\u5411\u7740\u5357\u5341\u5B57\u661F\u7684\u5C3D\u5934\u822A\u884C\uFF0C\u8FD9\u662F\u5341\u5B57\u661F\u5C9B\u7684\u5F00\u59CB\u3002"
