  - text: "\u4E5F\u8BB8\u5427\uFF0C\u56DE\u5FC6\u6709\u5982\u7901\u77F3\u4E0A\u7684\u9752\u82D4\uFF0C\u5728\u6F6E\u6C50\u65E5\u590D\u4E00\u65E5\u7684\u51B2\u5237\u4E0B\u6D88\u5931\u7684\u65E0\u5F71\u65E0\u8E2A\u3002"
