  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14811bc979276a24492db0c5e029371f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueStrings:
  - text: "\u57FA\u8BFA\uFF01\u53EF\u627E\u5230\u4F60\u4E86\u3002\u6211\u5C31\u77E5\u9053\uFF0C\u4F60\u80AF\u5B9A\u53C8\u5728\u8FD9\u91CC\u770B\u6D77\u3002"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u5854\u739B\uFF1F\u770B\u4F60\u8FD9\u4E48\u7740\u6025......"
    answerOption2: "\u662F\u90E8\u843D\u91CC\u6709\u4EC0\u4E48\u4E8B\u5417\uFF1F"
    option1IndexJump: 1
    option2IndexJump: 1
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u662F\u4F60\u8981\u7684\u90A3\u6761\u8239\uFF01\u6700\u540E\u4E00\u9053\u5DE5\u5E8F\u5DF2\u7ECF\u5B8C\u6210\u4E86\uFF0C\u6BD4\u6211\u9884\u60F3\u7684\u8FD8\u8981\u7ED3\u5B9E\u3002\u73B0\u5728\u5B83\u6B63\u7A33\u7A33\u5730\u505C\u5728\u8239\u575E\u91CC\uFF0C\u5C31\u7B49\u7740\u5B83\u7684\u8239\u957F\u4E86\u3002"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u592A\u597D\u4E86\uFF01\u6BD4\u6211\u4EEC\u7EA6\u5B9A\u7684\u65F6\u95F4\u8FD8\u8981\u65E9\uFF01"
    answerOption2: "\u5854\u739B\uFF0C\u591A\u4E8F\u6709\u4F60\u3002"
    option1IndexJump: 2
    option2IndexJump: 2
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u8C22\u6211\u505A\u4EC0\u4E48\uFF0C\u662F\u5927\u5BB6\u4E00\u8D77\u8D76\u5DE5\u7684\u7ED3\u679C"
    isEnd: 0
    isQuestion: 0
    answerOption1: ' '
    answerOption2: ' '
    option1IndexJump: 3
    option2IndexJump: 3
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u770B\u5230\u5B83\u771F\u7684\u9020\u597D\u4E86\uFF0C\u5FC3\u91CC\u53CD\u800C\u66F4\u2026\u2026"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 4
    option2IndexJump: 4
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u7B97\u4E86\uFF0C\u5148\u4E0D\u8BF4\u8FD9\u4E2A\u3002\u4F60\u662F\u73B0\u5728\u5C31\u8981\u56DE\u53BB\u770B\u770B\u5417\uFF1F"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u5F53\u7136\u3002\u6211\u4EEC\u8FD9\u5C31\u56DE\u53BB"
    answerOption2: "\u8D70\u5427\uFF0C\u53BB\u770B\u770B\u6211\u4EEC\u7684\u8239\u3002"
    option1IndexJump: 5
    option2IndexJump: 5
    startDialogueEvent:
      m_PersistentCalls:
