  m_Script: {fileID: 11500000, guid: 8d6101cc697a2ac419c085dd72cad93f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueStrings:
  - text: "\u57FA\u8BFA\u59D0\u59D0\uFF01"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u62C9\u62C9\uFF01\u4F60\u5728\u5E72\u4EC0\u4E48\u5462\uFF1F"
    answerOption2: "\u62C9\u62C9\uFF01\u597D\u4E45\u4E0D\u89C1"
    option1IndexJump: 1
    option2IndexJump: 5
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u6211\u5728\u5531\u201C\u5C9B\u8C23\u201D\uFF0C\u4F46\u662F\u6211\u603B\u5531\u9519\xB7\xB7\xB7\xB7\xB7\xB7"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u90A3\u8BA9\u6211\u542C\u542C\u770B\uFF01"
    answerOption2: "\u90A3\u6211\u6559\u4F60\u5531\u5427\uFF01"
    option1IndexJump: 2
    option2IndexJump: 2
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u597D\uFF01\u6211\u6765\u5F00\u5934\uFF0C\u201C\u5F2F\u5F2F\u7684\u6708\u513F\uFF0C\u8EBA\u5728\u6D77\u4E2D\u592E\u2026\u2026\u201D"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u4E00\u5934\u6795\u7740\u73CA\u745A\u5E8A\uFF0C\u4E00\u5934\u7FD8\u7740\u770B\u8FDC\u65B9\uFF01 "
    answerOption2: "\u771F\u68D2\uFF01\u7EE7\u7EED\u5427"
    option1IndexJump: 3
    option2IndexJump: 3
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u957F\u957F\u7684\u5C3E\u5DF4\u5C16\uFF0C\u6307\u5411\u661F\u8FB0\u843D\u4E0B\u7684\u5730\u65B9\u2026\u2026 "
    isEnd: 0
    isQuestion: 1
    answerOption1: "\uFF08\u5C3E\u5DF4\u5C16\u2026\u2026\u5411\u5185\u5F2F\u2026\u2026\uFF09"
    answerOption2: "\u90A3\u4F60\u77E5\u9053\u5B83\u4E3A\u4EC0\u4E48\u8FD9\u6837\u5531\u5417\uFF1F"
    option1IndexJump: 4
    option2IndexJump: 4
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u8FD9\u662F\u963F\u7237\u8BF4\uFF0C\u4ECE\u5F88\u9AD8\u7684\u5C71\u6216\u5F88\u8FDC\u7684\u8239\u4E0A\u770B\uFF0C\u6211\u4EEC\u7684\u5C9B\u5C31\u50CF\u4E00\u53EA\u5C3E\u5DF4\u5F2F\u5F2F\u7684\u957F\u5C3E\u9E1F\uFF01"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u539F\u6765\u6211\u4EEC\u811A\u4E0B\u7684\u571F\u5730\uFF0C\u4ECE\u8FDC\u5904\u770B\u662F\u8FD9\u6837\u7684\u5F62\u72B6\u2026\u2026"
    answerOption2: "\u8C22\u8C22\u4F60\u4EEC\uFF0C\u8FD9\u9996\u6B4C\u63D0\u9192\u4E86\u6211\u2014\u2014\u8981\u770B\u6E05\u5BB6\u4E61\uFF0C\u5F97\u5148\u77E5\u9053\u81EA\u5DF1\u62E5\u6709\u4EC0\u4E48"
    option1IndexJump: 5
    option2IndexJump: 5
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u5BF9\u4E86\uFF0C\u5E93\u62C9\u5976\u5976\u5750\u5728\u95E8\u5ECA\u90A3\uFF0C\u4F60\u8981\u53BB\u770B\u770B\u5979\u5417\uFF1F"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u662F\u7684\uFF0C\u6211\u73B0\u5728\u5C31\u53BB"
    answerOption2: "\u6211\u5148\u5728\u9644\u8FD1\u8F6C\u8F6C\uFF0C\u7B49\u4F1A\u518D\u53BB"
    option1IndexJump: 6
    option2IndexJump: 6
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u518D\u89C1\u4E86\uFF01"
    isEnd: 1
    isQuestion: 0
    answerOption1: "\u518D\u89C1\uFF01"
    answerOption2: "\u518D\u89C1\uFF01"
