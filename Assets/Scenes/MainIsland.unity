  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueStrings:
  - text: "\u57FA\u8BFA\uFF0C\u4F60\u6765\u4E86\uFF01"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u5976\u5976\uFF0C\u6211\u60F3\u518D\u542C\u542C\u7956\u5148\u662F\u5982\u4F55\u6765\u5230\u8FD9\u91CC\u7684\u3002"
    answerOption2: "\u5976\u5976\uFF0C\u5927\u5BB6\u73B0\u5728\u90FD\u5728\u54EA\u5462\uFF1F"
    option1IndexJump: 1
    option2IndexJump: 3
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u5728\u5F88\u4E45\u4EE5\u524D\uFF0C\u4ED6\u4EEC\u8FFD\u968F\u84DD\u6708\u7684\u5149\uFF0C\u4E58\u7740\u72EC\u6728\u821F\u5411\u897F\u822A\u884C\u3002\u7A7F\u8D8A\u98CE\u66B4\u548C\u6D53\u96FE\uFF0C\u6700\u540E\u770B\u5230\u4E86\u957F\u5C3E\u9E1F\uFF0C\u627E\u5230\u4E86\u8FD9\u5EA7\u5C9B\u3002 "
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u6240\u4EE5\u4ED6\u4EEC\u771F\u7684\u8DE8\u8FC7\u4E86\u5927\u6D77\u2026\u2026"
    answerOption2: "\u7956\u5148\u592A\u4F1F\u5927\u4E86\uFF01"
    option1IndexJump: 2
    option2IndexJump: 2
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u5B69\u5B50\uFF0C\u5927\u6D77\u662F\u9053\u8DEF\uFF0C\u4E0D\u662F\u56F4\u5899\u3002\u4F46\u8DEF\u8981\u8D70\u5F97\u8FDC\uFF0C\u5F97\u5148\u6709\u80FD\u8F7D\u4F60\u7684\u8239\u2014\u2014\u4E5F\u79BB\u4E0D\u5F00\u80FD\u5212\u8239\u7684\u4EBA"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u60A8\u8BF4\u5F97\u5BF9"
    answerOption2: "\u5982\u679C\u8239\u4E0D\u7ED3\u5B9E\uFF0C\u518D\u5F3A\u7684\u98CE\u4E5F\u65E0\u6CD5\u53BB\u8FDC\u65B9\uFF1B\u5982\u679C\u6CA1\u6709\u4EBA\u624B\uFF0C\u518D\u597D\u7684\u8239\u4E5F\u65E0\u6CD5\u822A\u884C"
    option1IndexJump: 3
    option2IndexJump: 3
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u5927\u5BB6\u73B0\u5728\u90FD\u5728\u8425\u5730\u5E7F\u573A\u7684"
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u6211\u73B0\u5728\u5C31\u53BB\u8425\u5730\u91CC\u627E\u5927\u5BB6"
    answerOption2: "\u8C22\u8C22\u60A8\u4E86\uFF0C\u518D\u89C1\uFF01"
    option1IndexJump: 4
    option2IndexJump: 4
    startDialogueEvent:
