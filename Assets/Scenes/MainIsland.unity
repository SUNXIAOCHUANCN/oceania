  - text: "\u5176\u5B9E\uFF0C\u4E0D\u53EA\u662F\u7FBD\u6BDB\u4F1A\u53D8\u2026\u2026\u6211\u4EEC\u7684\u4F5C\u7269\u548C\u7272\u755C\u4E5F\u4E00\u6837\u3002"
    isEnd: 0
    isQuestion: 0
    answerOption1: 
    answerOption2: 
    option1IndexJump: 3
    option2IndexJump: 3
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u5982\u679C\u603B\u662F\u5728\u540C\u4E00\u7247\u571F\u5730\u79CD\u690D\u540C\u6837\u7684\u4F5C\u7269\uFF0C\u517B\u540C\u6837\u7684\u7272\u755C\uFF0C\u5B83\u4EEC\u7684\u4EA7\u91CF\u4F1A\u8D8A\u6765\u8D8A\u4F4E\uFF0C\u54C1\u8D28\u4E5F\u4F1A\u53D8\u5DEE\u2014\u2014\u8FD9\u5C31\u662F\u9000\u5316\u3002 "
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u65F6\u95F4\u4E0D\u4F1A\u9A97\u4EBA\uFF0C\u9000\u5316\u4E5F\u65E0\u6CD5\u907F\u514D\u2026\u2026"
    answerOption2: "\u90A3\u6211\u4EEC\u8BE5\u600E\u4E48\u529E\uFF1F"
    option1IndexJump: 4
    option2IndexJump: 4
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u5C31\u50CF\u7FBD\u6BDB\u9700\u8981\u4E0D\u540C\u7684\u5149\u7EBF\u624D\u80FD\u5C55\u73B0\u4E0D\u540C\u8272\u5F69\uFF0C\u4F5C\u7269\u548C\u7272\u755C\u4E5F\u9700\u8981\u65B0\u7684\u53D8\u79CD\u6765\u4FDD\u6301\u6D3B\u529B\u3002\u4F60\u5E94\u8BE5\u51FA\u6D77\u53BB\u5BFB\u627E\u5176\u4ED6\u5C9B\u5C7F\u7684\u65B0\u54C1\u79CD\u4E86\u3002 "
    isEnd: 0
    isQuestion: 1
    answerOption1: "\u4F60\u8BF4\u5F97\u5BF9\u3002\u5B88\u7740\u65E7\u7684\u4E00\u5207\u53EA\u4F1A\u6162\u6162\u8870\u8D25\u3002"
    answerOption2: "\u6211\u8FD9\u5C31\u53BB\u6E2F\u53E3\u7801\u5934\u51C6\u5907\u51FA\u6D77\uFF0C\u51C6\u5907\u597D\u8239\u53EA\u548C\u7269\u8D44\uFF0C\u53BB\u5BFB\u627E\u65B0\u7684\u79CD\u5B50\u548C\u7272\u755C\u3002"
    option1IndexJump: 5
    option2IndexJump: 5
    startDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    endDialogueEvent:
      m_PersistentCalls:
        m_Calls: []
    speakerName: 
  - text: "\u8BB0\u5F97\u51FA\u6D77\u7684\u65F6\u5019\u5E26\u4E0A\u9A6F\u5316\u5E08\uFF0C\u8FD9\u6837\u4F60\u624D\u53EF\u4EE5\u6361\u8D77\u6765\u91CE\u751F\u7684\u7269\u79CD\uFF01"
    isEnd: 1
    isQuestion: 0
    answerOption1: "\u8C22\u8C22\u4E86"
    answerOption2: "\u518D\u89C1"
    option1IndexJump: 0
    option2IndexJump: 0
