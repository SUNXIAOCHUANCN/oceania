--- !u!114 &273294114
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 273294113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4bd9273d525002e429bc69724d07b37c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextShowTrigger
  textStrings:
  - text: "\u6BCF\u6B21\u56DE\u5230\u8FD9\u91CC\uFF0C\u90FD\u89C9\u5F97\u98CE\u91CC\u7684\u6C14\u606F\u90FD\u4E0D\u4E00\u6837\u4E86......"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u4EE5\u524D\u603B\u89C9\u5F97\u957F\u5C3E\u9E1F\u5C9B\u53EA\u662F'\u5BB6'\uFF0C\u662F\u51FA\u53D1\u7684\u5730\u65B9\uFF0C\u662F\u5F52\u6765\u65F6\u706F\u706B\u901A\u660E\u7684\u6E2F\u6E7E"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u53EF\u5982\u4ECA\uFF0C\u5728\u6D77\u4E0A\u8D70\u8FC7\u4E00\u906D\u518D\u56DE\u5934\u770B\u770B\uFF0C\u6216\u8BB8\u4ECE\u6765\u90FD\u4E0D\u53EA\u662F'\u5BB6\u4E61'\u90A3\u4E48\u7B80\u5355"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u662F\u8BE5\u597D\u597D\u8D70\u8D70\u4E86------"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u53BB\u542C\u542C\u8001\u4EBA\u600E\u4E48\u5F62\u5BB9\u5C9B\u7684\u8F6E\u5ED3\uFF0C\u53BB\u95EE\u95EE\u5B69\u5B50\u7AE5\u8C23\u91CC\u6F0F\u6389\u7684\u8BCD\u53E5"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u751A\u81F3\u53BB\u6570\u6570\u957F\u5C3E\u9E1F\u6362\u7FBD\u65F6\u843D\u4E0B\u7684\u7B2C\u4E00\u6839\u7FBD\u6BDB......"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u6BD5\u7ADF\uFF0C\u5982\u679C\u8FDE\u81EA\u5DF1\u7684\u6839\u90FD\u6478\u4E0D\u900F\uFF0C\u53C8\u8BE5\u600E\u4E48\u8BFB\u61C2\u8FDC\u65B9\u661F\u8FB0\u7684\u8C1C\u9898\uFF1F"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u7B49\u6211\u8D70\u5B8C\u8FD9\u4E00\u5708......\u518D\u53BB\u90A3\u4E2A\u53EA\u5C5E\u4E8E\u6211\u7684\u5D16\u9876\u79D8\u5BC6\u57FA\u5730\u5427\u3002\u6709\u4E9B\u4E8B\uFF0C\u5F97\u8BA9\u6D77\u98CE\u966A\u7740\u624D\u80FD\u60F3\u660E\u767D\u3002"
    isEnd: 0
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u6B38\uFF0C\u68D5\u6988\u6811\u6797\u65C1\u8FB9\u7684\u662F\u62C9\u62C9\u5417\uFF1F\u5979\u5728\u5E72\u4EC0\u4E48\u5462\uFF1F"
    isEnd: 1
    showTime: 30
    startTextEvent:
      m_PersistentCalls:
        m_Calls: []
    endTextEvent:
      m_PersistentCalls:
        m_Calls: []
