  m_Name: MIclue2
  m_EditorClassIdentifier: Assembly-CSharp::ClueScriptableObject
  clueName: "\u6307\u5411\u6869"
  relatedIsland: 0
  clueText: "\u4E00\u6839\u6DF1\u6DF1\u6253\u5165\u5730\u4E0B\u7684\u7C97\u783A\u6728\u6869\uFF0C\u9876\u90E8\u88AB\u524A\u6210\u659C\u89D2\uFF0C\u6307\u5411\u897F\u5357\u3002\u6728\u8D28\u56E0\u5E74\u5C81\u4E45\u8FDC\u800C\u53D1\u9ED1\uFF0C\u4F46\u4E0A\u9762\u96D5\u523B\u7684\u8239\u4E0E\u9E1F\u7684\u56FE\u6848\u4ECD\u53EF\u8FA8\u8BA4\u3002\u201C\u6728\u6869\u7684\u6307\u5411\uFF0C\u5C31\u662F\u5F53\u5E74\u72EC\u6728\u821F\u822A\u884C\u7684\u65B9\u5411\u3002\u7A7F\u8D8A\u832B\u832B\u96FE\u6D77\uFF0C\u661F\u8FB0\u662F\u552F\u4E00\u7684\u7F57\u76D8\u3002\u5728\u51E0\u4E4E\u7EDD\u671B\u65F6\uFF0C\u9886\u822A\u8005\u770B\u89C1\u4E86\u897F\u5357\u65B9\u6D77\u9762\u4E0A\u4E00\u70B9\u7A33\u5B9A\u7684\u3001\u73CD\u73E0\u822C\u67D4\u767D\u7684\u5FAE\u5149\uFF0C\u90A3\u4E0D\u662F\u661F\u8FB0\uFF0C\u662F\u53E6\u4E00\u5EA7\u5C9B\u5C7F\u7684\u8F6E\u5ED3\u3002\u4ED6\u4EEC\u5411\u7740\u90A3\u5149\u524D\u8FDB\u3002\u5173\u4E8E\u90A3\u6B21\u822A\u884C\u6700\u540E\u7684\u7EAA\u5FF5\uFF0C\u5C31\u7559\u5728\u90A3\u5EA7\u5C9B\u5317\u89D2\u4E00\u5757\u6709\u7740\u8679\u5F69\u7EB9\u8DEF\u7684\u5CA9\u77F3\u4E0A\uFF0C\u90A3\u8272\u5F69\uFF0C\u4E0E\u6700\u53E4\u8001\u7684\u7FBD\u51A0\u540C\u6E90\u3002\u201D"
  keyText: "\u5173\u4E8E\u90A3\u6B21\u822A\u884C\u6700\u540E\u7684\u7EAA\u5FF5\uFF0C\u5C31\u7559\u5728\u90A3\u5EA7\u5C9B\u5317\u89D2\u4E00\u5757\u6709\u7740\u8679\u5F69\u7EB9\u8DEF\u7684\u5CA9\u77F3\u4E0A\uFF0C\u90A3\u8272\u5F69\uFF0C\u4E0E\u6700\u53E4\u8001\u7684\u7FBD\u51A0\u540C\u6E90\u3002"
  isUnlocked: 0
