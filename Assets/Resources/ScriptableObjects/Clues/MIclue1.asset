  m_Name: MIclue1
  m_EditorClassIdentifier: Assembly-CSharp::ClueScriptableObject
  clueName: "\u6D6A\u7EB9\u77F3"
  relatedIsland: 0
  clueText: "\u4E00\u5757\u88AB\u6D77\u6C34\u78E8\u53BB\u68F1\u89D2\u7684\u6DF1\u7070\u8272\u77F3\u677F\uFF0C\u8868\u9762\u6709\u4E00\u9053\u9053\u50CF\u662F\u88AB\u6C34\u6D41\u957F\u671F\u51B2\u5237\u51FA\u7684\u5929\u7136\u51F9\u69FD\u3002\u201C\u6F6E\u6C34\u6BCF\u65E5\u62B9\u53BB\u6C99\u6EE9\u4E0A\u7684\u8DB3\u8FF9\uFF0C\u5374\u62B9\u4E0D\u53BB\u77F3\u5934\u4E0A\u6D6A\u7684\u7EB9\u7406\u3002\u5148\u7956\u8BF4\uFF0C\u7B2C\u4E00\u6B21\u770B\u6E05\u5BB6\u5168\u8C8C\uFF0C\u4E0D\u662F\u5728\u9760\u5CB8\u65F6\uFF0C\u800C\u662F\u5728\u542F\u7A0B\u540E\u2014\u2014\u4ECE\u6E2F\u53E3\u540E\u9762\u90A3\u7247\u5F00\u9614\u7684\u8349\u576A\u56DE\u671B\uFF0C\u6574\u5EA7\u5C9B\u624D\u4F1A\u50CF\u4E00\u53EA\u6536\u62E2\u7FC5\u8180\u7684\u957F\u5C3E\u9E1F\uFF0C\u5F2F\u6708\u662F\u5B83\u7684\u8EAB\u8EAF\uFF0C\u90A3\u6761\u6DF1\u5165\u6D77\u4E2D\u7684\u72ED\u957F\u6C99\u6D32\u662F\u5B83\u5185\u94A9\u7684\u5C3E\u7FBD\u3002\u82E5\u60F3\u77E5\u6653\u4ED6\u4EEC\u4E3A\u4F55\u542F\u7A0B\uFF0C\u9700\u53BB\u90A3\u80FD\u671B\u89C1\u5168\u8C8C\u7684\u8349\u5730\uFF0C\u5BFB\u627E\u4E00\u6839\u523B\u7740\u72EC\u6728\u821F\u4E0E\u98DE\u9E1F\u7684\u53E4\u65E7\u6728\u6869\u3002\u201D"
  keyText: "\u4ECE\u6E2F\u53E3\u540E\u9762\u90A3\u7247\u5F00\u9614\u7684\u8349\u576A\u56DE\u671B\uFF0C\u6574\u5EA7\u5C9B\u624D\u4F1A\u50CF\u4E00\u53EA\u6536\u62E2\u7FC5\u8180\u7684\u957F\u5C3E\u9E1F"
  isUnlocked: 0
