  m_Name: MIclue3
  m_EditorClassIdentifier: Assembly-CSharp::ClueScriptableObject
  clueName: "\u8679\u5F69\u77F3"
  relatedIsland: 0
  clueText: "\u4E00\u5757\u88F8\u9732\u7684\u5CA9\u58C1\uFF0C\u8868\u9762\u8986\u76D6\u7740\u5927\u7247\u5947\u5F02\u3001\u6DA6\u6CFD\u7684\u5F69\u8272\u6655\u67D3\u75D5\u8FF9\uFF0C\u50CF\u662F\u628A\u84DD\u7EFF\u3001\u7D2B\u91D1\u7B49\u591A\u79CD\u77FF\u7269\u989C\u6599\u6CFC\u6D12\u4E0A\u53BB\uFF0C\u7ECF\u767E\u5E74\u98CE\u96E8\u878D\u5408\u800C\u6210\u7684\u81EA\u7136\u753B\u5377\u3002\u201C\u8FD9\u4E0D\u662F\u753B\uFF0C\u662F\u65F6\u5149\u3002\u53EA\u6709\u6700\u7EAF\u51C0\u7684\u77FF\u7269\u548C\u6700\u6F2B\u957F\u7684\u5C81\u6708\uFF0C\u624D\u80FD\u6C89\u6DC0\u51FA\u5982\u6B64\u6C89\u9759\u800C\u7EDA\u70C2\u7684\u2018\u53E4\u8272\u2019\u3002\u6B63\u5982\u521D\u4EE3\u65CF\u957F\u51A0\u5195\u4E0A\u7684\u5C3E\u7FBD\uFF0C\u5728\u6F2B\u957F\u5B88\u62A4\u4E2D\u7EFD\u653E\u51FA\u6BD4\u751F\u547D\u66F4\u7480\u74A8\u7684\u5149\u534E\u3002\u5236\u4F5C\u90A3\u9876\u51A0\u5195\u7684\u667A\u6167\u4E0E\u8BB0\u5FC6\uFF0C\u6E90\u4E8E\u66F4\u53E4\u8001\u7684\u5370\u8BB0\u2014\u2014\u53BB\u91CE\u6784\u6811\u8C37\u5BF9\u9762\u7684\u6C99\u6EE9\uFF0C\u5BFB\u627E\u90A3\u4E9B\u88AB\u6D77\u6D6A\u523B\u5728\u77F3\u5934\u4E0A\u7684\u3001\u6700\u521D\u7684\u6CE2\u6D6A\u4E0E\u5F62\u72B6\u5427\u3002\u7B54\u6848\u5728\u8D77\u70B9\u3002\u201D"
  keyText: "\u53BB\u91CE\u6784\u6811\u8C37\u5BF9\u9762\u7684\u6C99\u6EE9\uFF0C\u5BFB\u627E\u90A3\u4E9B\u88AB\u6D77\u6D6A\u523B\u5728\u77F3\u5934\u4E0A\u7684\u3001\u6700\u521D\u7684\u6CE2\u6D6A\u4E0E\u5F62\u72B6\u5427\u3002\u7B54\u6848\u5728\u8D77\u70B9\u3002"
  isUnlocked: 0
