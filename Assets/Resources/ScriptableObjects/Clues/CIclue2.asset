  clueName: "\u9057\u5740\u65C1\u7684\u9676\u7247"
  relatedIsland: 1
  clueText: "\u5728\u957F\u5C3E\u9E1F\u843D\u4E0B\u7684\u5730\u65B9\uFF0C\u6211\u4EEC\u56DE\u60F3\u7740\u90A3\u58F0\u96F7\u9E23\u4E0E\u98DE\u9E1F\u7684\u8E2A\u8FF9\u3002\u4E00\u4F4D\u957F\u8005\u6307\u5411\u661F\u661F\u6D88\u5931\u7684\u897F\u5357\u65B9\uFF0C\u8BF4\u9053\uFF1A\u201C\u9E1F\u4E3A\u6211\u4EEC\u6307\u660E\u4E86\u661F\u5760\u4E4B\u65B9\u5411\uFF0C\u5728\u5927\u6D77\u7684\u5165\u53E3\uFF0C\u5728\u9646\u5730\u7684\u5C3D\u5934\u3002\u53BB\u5C9B\u5C7F\u6700\u957F\u90A3\u4E2A\u89D2\u7684\u5C3D\u5934\u5BFB\u627E\u5427\uFF0C\u90A3\u91CC\u6709\u5927\u6D77\u6700\u521D\u7684\u8BB0\u5FC6\u3002\u201D\u6211\u4EEC\u4E8E\u662F\u5411\u5357\u822A\u884C\u3002"
  keyText: "\u9E1F\u4E3A\u6211\u4EEC\u6307\u660E\u4E86\u661F\u5760\u4E4B\u65B9\u5411\uFF0C\u4F46\u5927\u6D77\u7684\u5165\u53E3\uFF0C\u5728\u9646\u5730\u7684\u5C3D\u5934"
  isUnlocked: 0
